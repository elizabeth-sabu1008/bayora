# Bayora Gateway Environment Configuration
BAYORA_ENV="production"
GATEWAY_PORT=8000
DATABASE_PATH="/app/data/bayora.db"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-256-bit-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=10
ALLOWED_CLOCK_SKEW_SECONDS=60

# Oracle Configuration
DEFAULT_ROUND_BUDGET=50
DEFAULT_CUMULATIVE_BUDGET=500
RESPONSE_DEADLINE_MS=2000
FIXED_MAX_TOKENS=128
PROBING_SIMILARITY_THRESHOLD=0.80

# Isolated Zone Endpoints
ZONE_RED_URL="http://zone-red:8001"
ZONE_BLUE_URL="http://zone-blue:8002"
ZONE_MODEL_URL="http://zone-model:8003"
ZONE_EVIDENCE_URL="http://zone-evidence:8004"

# External BYOM Model
MODEL_CONFIG_PATH="/app/model.yaml"
OPENAI_API_KEY=""

# Cryptographic Anchor
ANCHOR_LOG_PATH="/evidence/anchors/anchor.log"
RFC3161_TSA_URL="" # Optional public TSA (e.g. http://timestamp.digicert.com)
