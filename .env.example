# ==============================================================================
# BAYORA Environment Configuration Template
# Copy this file to .env or .env.local and configure your secrets.
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI inference & red-teaming generation.
# Set this in your hosting provider's environment variables (Cloud Run, Render, Railway, etc.)
GEMINI_API_KEY=

# GEMINI_MODEL: Primary Gemini model identifier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# GEMINI_FALLBACK_MODEL: Fallback model if primary model fails with 503/429/high-demand (default: gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('production' | 'development')
NODE_ENV=production

# VLLM_BASE_URL: (Optional) Base URL of a vLLM server to stream real Prometheus
# prefix-cache metrics from /metrics (e.g. http://localhost:8000).
# If unset, cache telemetry reports 'vLLM not connected - cache metrics unavailable'.
VLLM_BASE_URL=
